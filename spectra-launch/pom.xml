<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.devops00.spectra</groupId>
        <artifactId>spectra-modules</artifactId>
        <version>${revision}</version>
        <relativePath>../spectra-modules/pom.xml</relativePath>
    </parent>

    <artifactId>spectra-launch</artifactId>

    <description>启动模块,使用者的业务也应该在这个包中进行扩展</description>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencies>
        <!-- 全量后端架构规则通过启动模块的完整业务 classpath 执行。 -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 目标数据库 schema 由 Flyway V1 起完整管理；不使用 baseline-on-migrate 兼容旧库。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <!-- Prometheus 仅在组合根装配，避免把监控出口扩散到聚合层或业务叶子模块。 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!-- 配置资源属于启动装配边界，不通过 common 传递。 -->
        <dependency>
            <groupId>com.devops00.spectra</groupId>
            <artifactId>spectra-config</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- === 项目模块-基础功能 === -->
        <!-- 统一通知模块 -->
        <dependency>
            <groupId>com.devops00.spectra</groupId>
            <artifactId>spectra-notification</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 文件上传 -->
        <dependency>
            <groupId>com.devops00.spectra</groupId>
            <artifactId>spectra-upload</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 工作流 -->
        <dependency>
            <groupId>com.devops00.spectra</groupId>
            <artifactId>spectra-workflow</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- === 项目模块-starter === -->
        <!-- Security -->
        <dependency>
            <groupId>com.devops00.spectra</groupId>
            <artifactId>spectra-security-spring-boot-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- === 项目模块-功能模块 === -->
        <!-- 基础模块 -->
        <dependency>
            <groupId>com.devops00.spectra</groupId>
            <artifactId>spectra-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- OA -->
        <dependency>
            <groupId>com.devops00.spectra</groupId>
            <artifactId>spectra-oa</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>


    <build>
        <plugins>
            <!-- 编译器插件 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.plugin.version}</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven.jar.plugin.version}</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.maven.plugin.version}</version>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <!-- 只有启动模块执行 spring-boot:run -->
                    <skip>false</skip>
                    <!-- 启动类 -->
                    <mainClass>com.devops00.spectra.launch.LaunchApplication</mainClass>
                    <!-- 排除lombok -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                    <!-- jvm参数 -->
                    <jvmArguments>
                        --add-modules ALL-SYSTEM --enable-native-access=ALL-UNNAMED
                    </jvmArguments>
                    <!-- 配置和 files/ 目录位于 spectra-admin 根目录，避免 spring-boot:run 以本模块为工作目录。 -->
                    <workingDirectory>${project.basedir}/..</workingDirectory>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
