<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.yangxj96.spectra.core.mapper.common.FileInfoMapper">

    <!-- @formatter:off -->
    <resultMap id="BaseResultMap"
               extends="io.github.yangxj96.spectra.common.base.BaseMapper.BaseAuditMap"
               type="io.github.yangxj96.spectra.core.javabean.common.entity.FileInfo">
        <!--@mbg.generated-->
        <!--@Table spectra.sys_file_info-->
        <result column="file_name"    property="fileName"/>
        <result column="origin_name"  property="originName"/>
        <result column="suffix"       property="suffix"/>
        <result column="path"         property="path"/>
        <result column="size"         property="size"/>
        <result column="hash"         property="hash"/>
        <result column="storage_type" property="storageType"/>
    </resultMap>
    <!-- @formatter:on -->

    <sql id="Base_Column_List">
        <!--@mbg.generated-->
        id,
        file_name,
        origin_name,
        suffix,
        path,
        "size",
        hash,
        storage_type,
        created_by,
        created_at,
        updated_by,
        updated_at,
        deleted,
        version
    </sql>

    <select id="getByHash" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM spectra.sys_file_info WHERE hash = #{hash}
    </select>
</mapper>