[tools]
java = "temurin-25.0.2+10.0.LTS"

[env]
# 默认密码
DEFAULT_PASSWORD = "admin123"
# 许可密码
LICENSE_PASSWORD = "admin123"
# SSL配置
SSL_PASSWORD = "xxx"
SSL_TYPE = "PKCS12"
SSL_ALIAS = "tomcat"
# 数据库相关配置
DB_URL = "jdbc:postgresql://localhost:5432/spectra_db"
DB_USERNAME = "postgres"
DB_PASSWORD = "xxx"
# Redis
REDIS_PORT = "6379"
REDIS_HOST = "127.0.0.1"
REDIS_DB = "0"
REDIS_PASSWORD = "XXX"
# 服务配置
SERVER_PORT = "8080"