<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.devops00.spectra.core.notification.mapper.NotificationSendPreviewMapper">
    <!-- @formatter:off -->
    <resultMap id="BaseResultMap"
               extends="com.devops00.spectra.common.base.BaseMapper.BaseAuditMap"
               type="com.devops00.spectra.core.notification.javabean.entity.NotificationSendPreviewEntity">
        <!--@mbg.generated-->
        <!--@Table spectra_notification.ntf_send_preview-->
        <result column="operator_user_id"   property="operatorUserId" typeHandler="com.devops00.spectra.framework.persistence.mybatis.handler.UUIDTypeHandler"/>
        <result column="request_hash"       property="requestHash"/>
        <result column="preview_token_hash" property="previewTokenHash"/>
        <result column="resolution_hash"    property="resolutionHash"/>
        <result column="request_snapshot"   property="requestSnapshot" typeHandler="com.devops00.spectra.framework.persistence.mybatis.PgJsonbTypeHandler"/>
        <result column="expires_at"         property="expiresAt"/>
        <result column="consumed_at"        property="consumedAt"/>
        <result column="applied_request_id" property="appliedRequestId" typeHandler="com.devops00.spectra.framework.persistence.mybatis.handler.UUIDTypeHandler"/>
        <result column="status"             property="status"/>
    </resultMap>
    <!-- @formatter:on -->

    <sql id="Base_Column_List">
        <!--@mbg.generated-->
        operator_user_id,
        request_hash,
        preview_token_hash,
        resolution_hash,
        request_snapshot,
        expires_at,
        consumed_at,
        applied_request_id,
        status,
        <include refid="com.devops00.spectra.common.base.BaseMapper.BaseAuditColumns"/>
    </sql>

    <delete id="deleteExpired">
        DELETE FROM spectra_notification.ntf_send_preview
        WHERE expires_at &lt; #{now}
           OR (status = 'APPLIED' AND consumed_at &lt; #{appliedCutoff})
    </delete>
</mapper>
