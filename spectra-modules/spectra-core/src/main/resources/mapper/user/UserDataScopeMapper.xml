<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.devops00.spectra.core.user.mapper.UserDataScopeMapper">
    <!-- @formatter:off -->
    <resultMap id="BaseResultMap"
               extends="com.devops00.spectra.common.base.BaseMapper.BaseAuditMap"
               type="com.devops00.spectra.core.user.javabean.entity.UserDataScope">
        <!--@mbg.generated-->
        <!--@Table spectra_core.sys_user_data_scope-->
        <result column="user_id"    property="userId"/>
        <result column="scope_type" property="scopeType"/>
    </resultMap>
    <!-- @formatter:on -->

    <sql id="Base_Column_List">
        <!--@mbg.generated-->
        user_id, scope_type,
        <include refid="com.devops00.spectra.common.base.BaseMapper.BaseAuditColumns"/>
    </sql>

    <select id="findByUserId" resultType="com.devops00.spectra.core.user.javabean.entity.UserDataScope">
        SELECT
        <include refid="Base_Column_List"/>
        FROM spectra_core.sys_user_data_scope AS suds
        WHERE suds.user_id = #{userId}
        AND suds.deleted IS NULL
    </select>

    <delete id="removeByUserId">
        DELETE
        FROM spectra_core.sys_user_data_scope
        WHERE user_id = #{userId}
    </delete>
</mapper>
