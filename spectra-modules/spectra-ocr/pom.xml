<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.devops00.spectra</groupId>
        <artifactId>spectra-modules</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>spectra-ocr</artifactId>

    <description>OCR 识别模块 (PaddleOCR ONNX Runtime)</description>

    <properties>
        <onnxruntime.version>1.27.0</onnxruntime.version>
        <javacv.version>1.5.13</javacv.version>
    </properties>

    <dependencies>
        <!-- ONNX Runtime -->
        <dependency>
            <groupId>com.microsoft.onnxruntime</groupId>
            <artifactId>onnxruntime</artifactId>
            <version>${onnxruntime.version}</version>
        </dependency>

        <!-- JavaCV (OpenCV) -->
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>javacv-platform</artifactId>
            <version>${javacv.version}</version>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <excludes>
                    <exclude>models/*.onnx</exclude>
                </excludes>
            </resource>
            <!-- 模型文件单独处理，不参与 filter -->
            <resource>
                <directory>src/main/resources/models</directory>
                <targetPath>models</targetPath>
                <filtering>false</filtering>
            </resource>
        </resources>
    </build>
</project>
