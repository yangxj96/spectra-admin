<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.devops00.spectra.notification.mapper.NotificationTaskMapper">
    <!-- @formatter:off -->
    <resultMap id="BaseResultMap"
               extends="com.devops00.spectra.common.base.BaseMapper.BaseAuditMap"
               type="com.devops00.spectra.notification.javabean.entity.NotificationTaskEntity">
        <!--@mbg.generated-->
        <!--@Table spectra_notification.ntf_task-->
        <result column="tenant_id"                       property="tenantId"/>
        <result column="notification_request_id"        property="notificationRequestId"/>
        <result column="channel"                         property="channel"/>
        <result column="receiver_user_id"                property="receiverUserId"/>
        <result column="recipient_key_hash"              property="recipientKeyHash"/>
        <result column="recipient_masked"                property="recipientMasked"/>
        <result column="recipient_ciphertext"            property="recipientCiphertext"/>
        <result column="template_id"                     property="templateId"/>
        <result column="purpose"                         property="purpose"/>
        <result column="title"                           property="title"/>
        <result column="content"                         property="content"/>
        <result column="link"                            property="link"/>
        <result column="extra"                           property="extra" typeHandler="com.devops00.spectra.common.mybatis.PgJsonbTypeHandler"/>
        <result column="sensitive_parameters_ciphertext" property="sensitiveParametersCiphertext"/>
        <result column="priority"                        property="priority"/>
        <result column="attempt_count"                   property="attemptCount"/>
        <result column="max_attempts"                    property="maxAttempts"/>
        <result column="scheduled_at"                    property="scheduledAt"/>
        <result column="next_retry_at"                   property="nextRetryAt"/>
        <result column="expires_at"                      property="expiresAt"/>
        <result column="locked_by"                       property="lockedBy"/>
        <result column="locked_at"                       property="lockedAt"/>
        <result column="status"                          property="status"/>
        <result column="last_error_code"                 property="lastErrorCode"/>
    </resultMap>
    <!-- @formatter:on -->

    <sql id="Base_Column_List">
        <!--@mbg.generated-->
        tenant_id,
        notification_request_id,
        channel,
        receiver_user_id,
        recipient_key_hash,
        recipient_masked,
        recipient_ciphertext,
        template_id,
        purpose,
        title,
        content,
        link,
        extra,
        sensitive_parameters_ciphertext,
        priority,
        attempt_count,
        max_attempts,
        scheduled_at,
        next_retry_at,
        expires_at,
        locked_by,
        locked_at,
        status,
        last_error_code,
        <include refid="com.devops00.spectra.common.base.BaseMapper.BaseAuditColumns"/>
    </sql>

    <!-- PostgreSQL 的锁定子句必须位于 ORDER BY/LIMIT 之后。 -->
    <select id="selectPendingTasks" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM spectra_notification.ntf_task
        WHERE deleted IS NULL
          AND status IN ('PENDING', 'RETRYING')
          AND scheduled_at &lt;= #{now}
          AND (next_retry_at IS NULL OR next_retry_at &lt;= #{now})
          AND (expires_at IS NULL OR expires_at &gt; #{now})
        ORDER BY priority DESC, scheduled_at ASC, created_at ASC
        LIMIT #{limit}
        FOR UPDATE SKIP LOCKED
    </select>
</mapper>
