<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
        xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
        xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
        xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
        xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:flowable="http://flowable.org/bpmn"
        targetNamespace="http://example.com/oa-approval">

    <!-- 单级审批流程：适用于大多数OA场景 -->
    <bpmn:process id="oaSingleApproval" name="OA单级审批流程" isExecutable="true">

        <!-- 开始事件 -->
        <bpmn:startEvent id="startEvent" name="开始"/>

        <!-- 提交申请 -->
        <bpmn:userTask
                id="submitApplication"
                name="提交申请"
                flowable:assignee="${applicant}"/>

        <!-- 审批人审批 -->
        <bpmn:userTask
                id="approveTask"
                name="审批人审批"
                flowable:assignee="${approver}"/>

        <!-- 是否通过 -->
        <bpmn:exclusiveGateway
                id="approveGateway"
                name="是否同意"/>

        <!-- 结束（通过） -->
        <bpmn:endEvent
                id="endApproved"
                name="审批通过"/>

        <!-- 结束（驳回） -->
        <bpmn:endEvent
                id="endRejected"
                name="审批驳回"/>

        <!-- 顺序流 -->
        <bpmn:sequenceFlow
                id="flow_start_submit"
                sourceRef="startEvent"
                targetRef="submitApplication"/>

        <bpmn:sequenceFlow
                id="flow_submit_approve"
                sourceRef="submitApplication"
                targetRef="approveTask"/>

        <bpmn:sequenceFlow
                id="flow_approve_gateway"
                sourceRef="approveTask"
                targetRef="approveGateway"/>

        <!-- 通过 -->
        <bpmn:sequenceFlow
                id="flow_gateway_approved"
                sourceRef="approveGateway"
                targetRef="endApproved">
            <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
                ${approved == true}
            </bpmn:conditionExpression>
        </bpmn:sequenceFlow>

        <!-- 驳回 -->
        <bpmn:sequenceFlow
                id="flow_gateway_rejected"
                sourceRef="approveGateway"
                targetRef="endRejected">
            <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
                ${approved == false}
            </bpmn:conditionExpression>
        </bpmn:sequenceFlow>

    </bpmn:process>

    <bpmndi:BPMNDiagram id="BPMNDiagram_1">
        <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="oaSingleApproval">

            <!-- 开始事件 -->
            <bpmndi:BPMNShape id="startEvent_di" bpmnElement="startEvent">
                <dc:Bounds x="196" y="200" width="36" height="36"/>
                <bpmndi:BPMNLabel>
                    <dc:Bounds x="209" y="242" width="24" height="14"/>
                </bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>

            <!-- 提交申请 -->
            <bpmndi:BPMNShape id="submitApplication_di" bpmnElement="submitApplication">
                <dc:Bounds x="320" y="178" width="100" height="80"/>
                <bpmndi:BPMNLabel/>
            </bpmndi:BPMNShape>

            <!-- 审批人审批 -->
            <bpmndi:BPMNShape id="approveTask_di" bpmnElement="approveTask">
                <dc:Bounds x="490" y="178" width="100" height="80"/>
                <bpmndi:BPMNLabel/>
            </bpmndi:BPMNShape>

            <!-- 是否同意 -->
            <bpmndi:BPMNShape id="approveGateway_di" bpmnElement="approveGateway" isMarkerVisible="true">
                <dc:Bounds x="655" y="193" width="50" height="50"/>
                <bpmndi:BPMNLabel>
                    <dc:Bounds x="668" y="249" width="24" height="14"/>
                </bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>

            <!-- 审批通过 -->
            <bpmndi:BPMNShape id="endApproved_di" bpmnElement="endApproved">
                <dc:Bounds x="812" y="200" width="36" height="36"/>
                <bpmndi:BPMNLabel>
                    <dc:Bounds x="818" y="242" width="24" height="14"/>
                </bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>

            <!-- 审批驳回 -->
            <bpmndi:BPMNShape id="endRejected_di" bpmnElement="endRejected">
                <dc:Bounds x="655" y="340" width="36" height="36"/>
                <bpmndi:BPMNLabel>
                    <dc:Bounds x="661" y="382" width="24" height="14"/>
                </bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>

            <!-- 顺序流 -->
            <bpmndi:BPMNEdge id="flow_start_submit_di" bpmnElement="flow_start_submit">
                <di:waypoint x="232" y="218"/>
                <di:waypoint x="320" y="218"/>
            </bpmndi:BPMNEdge>

            <bpmndi:BPMNEdge id="flow_submit_approve_di" bpmnElement="flow_submit_approve">
                <di:waypoint x="420" y="218"/>
                <di:waypoint x="490" y="218"/>
            </bpmndi:BPMNEdge>

            <bpmndi:BPMNEdge id="flow_approve_gateway_di" bpmnElement="flow_approve_gateway">
                <di:waypoint x="590" y="218"/>
                <di:waypoint x="655" y="218"/>
            </bpmndi:BPMNEdge>

            <bpmndi:BPMNEdge id="flow_gateway_approved_di" bpmnElement="flow_gateway_approved">
                <di:waypoint x="705" y="218"/>
                <di:waypoint x="812" y="218"/>
            </bpmndi:BPMNEdge>

            <bpmndi:BPMNEdge id="flow_gateway_rejected_di" bpmnElement="flow_gateway_rejected">
                <di:waypoint x="680" y="243"/>
                <di:waypoint x="680" y="340"/>
            </bpmndi:BPMNEdge>

        </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>

</bpmn:definitions>
