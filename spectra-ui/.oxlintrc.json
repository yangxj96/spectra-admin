{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["import", "typescript", "unicorn"],
    "env": {
        "browser": true
    },
    "globals": {},
    "settings": {},
    "rules": {
        "eqeqeq": "warn",
        "noEmpty": "error",
        "noImplicitGlobals": "error",
        "noEmptyInterface": "error",
        "noUnusedVars": "error",
        "useIsNaN": "error",
        "noExplicitAny": "error",
        "noVarRequires": "error",
        "import/order": "error",
        "import/noCycle": "error",
        "import/noUnresolved": "error",
        "noVar": "error",
        "import/no-restricted-imports": [
            "error",
            {
                "paths": [
                    {
                        "name": "element-plus",
                        "importNames": ["ElMessage"],
                        "message": "禁止直接使用 ElMessage,请使用utils/MessageHelp中的MessageHelp工具类"
                    }
                ]
            }
        ]
    },
    "overrides": [
        {
            "files": ["*.test.ts", "*.spec.ts"],
            "rules": {
                "noExplicitAny": "off"
            }
        }
    ]
}
