{
    "name": "spectra-web",
    "author": {
        "name": "Jack Young",
        "email": "yangxj96@gmail.com",
        "url": "https://www.yangxj96.com/"
    },
    "license": "Apache-2.0",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "start": "vite",
        "build": "vite build",
        "preview": "vite preview --host",
        "format": "prettier . --write --config ./.prettierrc.yml --log-level silent",
        "lint": "oxlint  ./src -c ./.oxlintrc.json",
        "lint:fix": "oxlint  ./src --fix -c ./.oxlintrc.json",
        "type-check": "vue-tsc --noEmit --composite false",
        "test": "vitest run",
        "test:watch": "vitest",
        "prestart": "npm run format && npm run lint && npm run type-check"
    },
    "lint-staged": {
        "*.{js,ts,vue}": "oxlint",
        "*.{js,ts,vue,css,scss,json,yml,md}": "prettier --write",
        "*.{ts,vue}": "vue-tsc --noEmit"
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged"
        }
    },
    "dependencies": {
        "@form-create/designer": "3.4.0",
        "@form-create/element-ui": "3.2.33",
        "@logicflow/core": "2.2.0",
        "@logicflow/extension": "2.2.0",
        "@vueuse/core": "14.1.0",
        "@yangxj96/logicflow-flowable": "0.0.1-dev.20260119.0",
        "axios": "1.13.2",
        "echarts": "6.0.0",
        "element-plus": "2.12.0",
        "jsoneditor": "10.4.2",
        "lodash": "4.17.21",
        "p-queue": "9.0.1",
        "pinia": "3.0.4",
        "pinia-plugin-persistedstate": "4.7.1",
        "prismjs": "1.30.0",
        "qs": "6.14.1",
        "sass": "1.97.0",
        "sm-crypto-v2": "1.15.1",
        "suncalc": "1.9.0",
        "vue": "3.5.26",
        "vue-echarts": "8.0.1",
        "vue-router": "4.6.4"
    },
    "devDependencies": {
        "@pinia/testing": "1.0.3",
        "@tsconfig/node22": "22.0.5",
        "@types/jsoneditor": "9.9.6",
        "@types/node": "24.10.4",
        "@types/prismjs": "1.26.5",
        "@types/qs": "6.14.0",
        "@types/suncalc": "1.9.2",
        "@vitejs/plugin-vue": "6.0.3",
        "@vitejs/plugin-vue-jsx": "5.1.2",
        "@vue/test-utils": "2.4.6",
        "@vue/tsconfig": "0.8.1",
        "globals": "16.5.0",
        "happy-dom": "20.0.11",
        "husky": "9.1.7",
        "lint-staged": "16.2.7",
        "npm-run-all2": "8.0.4",
        "oxlint": "1.33.0",
        "prettier": "3.7.4",
        "terser": "5.44.1",
        "typescript": "5.9.3",
        "vite": "7.3.0",
        "vite-plugin-compression": "0.5.1",
        "vite-plugin-vue-devtools": "8.0.5",
        "vitest": "4.0.16",
        "vue-tsc": "3.1.8"
    },
    "overrides": {
        "vite-plugin-inspect": "11.3.0"
    },
    "browserslist": [
        "> 1%",
        "last 2 versions",
        "not dead"
    ]
}
