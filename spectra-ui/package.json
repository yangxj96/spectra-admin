{
    "name": "spectra-web",
    "author": {
        "name": "Jack Young",
        "email": "yangxj96@gmail.com",
        "url": "https://www.yangxj96.com/"
    },
    "license": "Apache-2.0",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "start": "vite",
        "build": "vite build",
        "preview": "vite preview --host",
        "format": "prettier . --write --config ./.prettierrc.yml --log-level silent",
        "lint": "oxlint  ./src -c ./.oxlintrc.json",
        "lint:fix": "oxlint  ./src --fix -c ./.oxlintrc.json",
        "type-check": "vue-tsc --noEmit --composite false",
        "prestart": "npm run format && npm run lint && npm run type-check"
    },
    "lint-staged": {
        "*.{js,ts,vue}": "oxlint",
        "*.{js,ts,vue,css,scss,json,yml,md}": "prettier --write",
        "*.{ts,vue}": "vue-tsc --noEmit"
    },
    "husky": {
        "hooks": {
            "pre-commit": "npm run format && npm run lint && npm run type-check"
        }
    },
    "dependencies": {
        "@prettier/plugin-oxc": "0.0.4",
        "@vueuse/core": "13.9.0",
        "axios": "1.12.2",
        "echarts": "6.0.0",
        "element-plus": "2.11.3",
        "follow-redirects": "1.15.11",
        "jsoneditor": "10.4.1",
        "lodash": "4.17.21",
        "p-queue": "8.1.1",
        "pinia": "3.0.3",
        "pinia-plugin-persistedstate": "4.5.0",
        "prismjs": "1.30.0",
        "qs": "6.14.0",
        "sass": "1.93.2",
        "sm-crypto-v2": "1.14.0",
        "suncalc": "1.9.0",
        "vue": "3.5.21",
        "vue-echarts": "8.0.0",
        "vue-router": "4.5.1"
    },
    "devDependencies": {
        "@tsconfig/node22": "22.0.2",
        "@types/jsoneditor": "9.9.6",
        "@types/node": "24.5.2",
        "@types/prismjs": "1.26.5",
        "@types/qs": "6.14.0",
        "@types/suncalc": "1.9.2",
        "@vitejs/plugin-vue": "6.0.1",
        "@vue/tsconfig": "0.8.1",
        "cross-conf-env": "1.3.0",
        "globals": "16.4.0",
        "husky": "9.1.7",
        "lint-staged": "16.2.0",
        "npm-run-all2": "8.0.4",
        "oxlint": "1.24.0",
        "prettier": "3.6.2",
        "terser": "5.44.0",
        "typescript": "5.8.3",
        "unplugin-auto-import": "20.2.0",
        "unplugin-vue-components": "29.1.0",
        "vite": "7.1.12",
        "vite-plugin-compression": "0.5.1",
        "vite-plugin-vue-devtools": "8.0.2",
        "vue-tsc": "3.0.8"
    },
    "overrides": {
        "vite-plugin-inspect": "11.3.0"
    },
    "browserslist": [
        "> 1%",
        "last 2 versions",
        "not dead"
    ],
    "volta": {
        "node": "22.19.0"
    }
}
