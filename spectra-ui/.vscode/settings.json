{
    // ---------- 格式化 ----------
    // 保存时候格式化
    "editor.formatOnSave": true,
    // 保存用 Prettier 格式化
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    // prettier存在的时候才生效
    "prettier.requireConfig": true,
    // ---------- 文件嵌套 ----------
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        "tsconfig.json": "tsconfig.*.json, env.d.ts, typed-router.d.ts",
        "vite.config.*": "jsconfig*, vitest.config.*, cypress.config.*, playwright.config.*",
        "package.json": "package-lock.json, pnpm*, .yarnrc*, yarn*, .eslint*, eslint*, .oxlint*, oxlint*, .oxfmt*, .prettier*, prettier*, .editorconfig",
        ".env": ".env.*, .local, .production, .development"
    },
    // ---------- 杂项 ----------
    // 启用 ESLint 自动修复
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit"
    },
    // 如果使用 TypeScript，确保 Volar 接管 TS 功能 (新版 Vue - Official 通常自动处理，但可显式声明)
    "vue.server.includeLanguages": ["vue"],
    "eslint.validate": ["javascript", "typescript", "vue"],
    // 确保 Vue 文件使用 Vue - Official 插件处理 (防止被其他插件抢占)
    "files.associations": {
        "*.vue": "vue"
    },
    // 词汇
    "cSpell.words": ["autoresize", "echarts", "gropus", "iconfont", "VITE"],
    "conventionalCommits.scopes": ["request"]
}
