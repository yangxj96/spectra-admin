[tools]
java = "temurin-25.0.2+10.0.LTS"

[env]
# 默认密码
DEFAULT_PASSWORD = "admin123"
# SSL配置
SSL_PASSWORD = "xxx"
SSL_TYPE = "PKCS12"
SSL_ALIAS = "tomcat"
# 数据库相关配置
DB_URL = "jdbc:postgresql://localhost:5432/devops00_spectra_db"
DB_USERNAME = "postgres"
DB_PASSWORD = "xxx"
# Redis
REDIS_PORT = "6379"
REDIS_HOST = "127.0.0.1"
REDIS_DB = "0"
REDIS_PASSWORD = "XXX"
# 服务配置
SERVER_PORT = "8080"
# S3服务器
S3_ENDPOINT= ""
S3_ACCESS_KEY= ""
S3_SECRET_KEY= ""
S3_BUCKET= ""
S3_REGION= ""
# AI
AI_KEY= ""
AI_BASE_URL= ""
AI_MODEL= ""
# RAG
RAG_KEY= ""
RAG_BASE_URL= ""
RAG_MODEL= ""
# 接口加解密（默认关闭，启用时需设置 enabled=true 并填入 RSA 密钥对）
SPECTRA_SYSTEM_SM_ENABLED = "false"
SPECTRA_SYSTEM_SM_PUBLIC_KEY = ""
SPECTRA_SYSTEM_SM_PRIVATE_KEY = ""