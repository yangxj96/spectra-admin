[env]
# 仅用于隔离的本地开发环境；共享/生产环境必须更换
DEFAULT_PASSWORD = "change-me"
SPECTRA_CORS_ORIGIN_ALLOWLIST = "http://localhost:5173,http://127.0.0.1:5173"
SPECTRA_CORS_REQUIRED = "false"

# 安全 Cookie/CSRF：生产环境必须结合 HTTPS、精确 Origin 和反向代理策略复核
SPECTRA_SECURITY_REFRESH_COOKIE_NAME = "__Host-spectra-refresh"
SPECTRA_SECURITY_REFRESH_COOKIE_SECURE = "true"
SPECTRA_SECURITY_REFRESH_COOKIE_SAME_SITE = "Strict"
SPECTRA_SECURITY_REFRESH_COOKIE_SAME_SITE_NONE_ALLOWED = "false"
SPECTRA_SECURITY_REFRESH_COOKIE_PATH = "/"
SPECTRA_SECURITY_REFRESH_COOKIE_DOMAIN = ""
SPECTRA_SECURITY_CSRF_COOKIE_NAME = "XSRF-TOKEN"
SPECTRA_SECURITY_CSRF_HEADER_NAME = "X-XSRF-TOKEN"

# MFA 密钥只允许从本机密钥管理/环境注入；这里保持空值以避免示例携带密钥
SPECTRA_SECURITY_MFA_ENCRYPTION_KEY = ""
SPECTRA_SECURITY_MFA_ENCRYPTION_KEY_VERSION = "v1"
SPECTRA_SECURITY_MFA_PREVIOUS_ENCRYPTION_KEY = ""
SPECTRA_SECURITY_MFA_PREVIOUS_ENCRYPTION_KEY_VERSION = ""

# 安全审计归档：本地默认不启用真实 WORM 后端
SPECTRA_SECURITY_AUDIT_ARCHIVE_BACKEND = "PENDING"
S3_SECURITY_AUDIT_ARCHIVE_BUCKET = ""
S3_SECURITY_AUDIT_ARCHIVE_PREFIX = "security-audit/"

# 反向代理头只信任受控入口
SERVER_FORWARD_HEADERS_STRATEGY = "framework"
SECURITY_VERIFICATION_CODE_HMAC_KEY = ""
SECURITY_VERIFICATION_CODE_MAX_ATTEMPTS = "5"

# 服务配置：首次启动默认使用 HTTP 4004
SERVER_PORT = "4004"
SERVER_SSL_ENABLED = "false"

# 启用本地 HTTPS 时配置，证书默认路径为 files/ssl/keystore.p12
SSL_PASSWORD = "change-me"
SSL_TYPE = "PKCS12"
SSL_ALIAS = "tomcat"

# PostgreSQL：必须改成当前机器真实可连接的值
DB_URL = "jdbc:postgresql://127.0.0.1:5432/devops00_spectra_db"
DB_USERNAME = "postgres"
DB_PASSWORD = "change-me"
SPECTRA_FLYWAY_ENABLED = "true"

# Redis：当前连接串要求密码认证
REDIS_PORT = "6379"
REDIS_HOST = "127.0.0.1"
REDIS_DB = "0"
REDIS_PASSWORD = "change-me"

# 通知：外部地址和敏感载荷必须使用 Base64 编码的 16/24/32 字节密钥；空值保持外部渠道不可用
NOTIFICATION_ENABLED = "true"
NOTIFICATION_ADDRESS_ENCRYPTION_KEY = ""
NOTIFICATION_SENSITIVE_PAYLOAD_KEY = ""
NOTIFICATION_ALLOWED_LINK_PREFIXES = "/login,/auth/,/oa/,/workflow/,/notification/,/notification-center/,/system/,/file/,/ai/"
NOTIFICATION_WORKER_FIXED_DELAY_MS = "5000"
NOTIFICATION_WORKER_PROCESSING_TIMEOUT_SECONDS = "300"
NOTIFICATION_WORKER_RETRY_BASE_DELAY_SECONDS = "5"
NOTIFICATION_CLEANUP_ENABLED = "true"
NOTIFICATION_CLEANUP_FIXED_DELAY_MS = "3600000"
NOTIFICATION_CLEANUP_BATCH_SIZE = "100"
NOTIFICATION_CLEANUP_RETENTION_SECONDS = "86400"

# S3：以下本机占位值可让配置完成绑定；使用上传功能前必须接入真实 S3/MinIO
S3_ENDPOINT = "http://127.0.0.1:9000"
S3_ACCESS_KEY = "local-placeholder"
S3_SECRET_KEY = "local-placeholder"
S3_BUCKET = "spectra-local"
S3_REGION = "us-east-1"

# AI：本机占位端点不会自动提供模型服务；调用 AI 功能前必须替换
AI_KEY = "local-placeholder"
AI_BASE_URL = "http://127.0.0.1:11434/v1"
AI_MODEL = "local-placeholder"

# RAG/Embedding：调用 RAG 前必须配置真实兼容端点和模型
RAG_KEY = "local-placeholder"
RAG_BASE_URL = "http://127.0.0.1:11434/v1"
RAG_MODEL = "local-placeholder"
