[env]
# 密钥管理数据库根密钥：Base64 编码后必须正好 32 字节；只通过部署环境注入，不能在页面编辑
SPECTRA_SECURITY_SECRET_MASTER_KEY = ""

# 启用本地 HTTPS 时配置，证书默认路径为 files/ssl/keystore.p12
SSL_PASSWORD = "change-me"
SSL_TYPE = "PKCS12"
SSL_ALIAS = "tomcat"

# PostgreSQL：必须改成当前机器真实可连接的值
DB_URL = "jdbc:postgresql://127.0.0.1:5432/spectra_db"
DB_USERNAME = "postgres"
DB_PASSWORD = "change-me"

# Redis：当前连接串要求密码认证
REDIS_PORT = "6379"
REDIS_HOST = "127.0.0.1"
REDIS_DB = "0"
REDIS_PASSWORD = "change-me"

# S3：以下本机占位值可让配置完成绑定；使用上传功能前必须接入真实 S3/MinIO
S3_ENDPOINT = "http://127.0.0.1:9000"
S3_ACCESS_KEY = "local-placeholder"
S3_SECRET_KEY = "local-placeholder"
S3_BUCKET = "spectra-local"
S3_REGION = "us-east-1"
