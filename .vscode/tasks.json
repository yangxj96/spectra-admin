{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "后端 API · Spring Boot run（mise）",
            "type": "process",
            "command": "mise.exe",
            "args": [
                "exec",
                "--",
                ".\\mvnw.cmd",
                "-pl",
                "spectra-launch",
                "spring-boot:run"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "showReuseMessage": false,
                "clear": false
            }
        },
        {
            "label": "后端 API · Spring Boot run（mise · launch POM）",
            "type": "process",
            "command": "mise.exe",
            "args": [
                "exec",
                "--",
                ".\\mvnw.cmd",
                "-f",
                "spectra-launch\\pom.xml",
                "spring-boot:run"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "showReuseMessage": false,
                "clear": false
            }
        }
    ]
}
