{
    "extends": "@vue/tsconfig/tsconfig.json",
    "compilerOptions": {
        "ignoreDeprecations": "6.0",
        "verbatimModuleSyntax": true,
        "sourceMap": true,
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "./src/*"
            ]
        },
        "lib": [
            "esnext",
            "dom"
        ],
        "types": [
            "@dcloudio/types"
        ],
        "importsNotUsedAsValues": "remove",
        "preserveValueImports": false
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.d.ts",
        "src/**/*.tsx",
        "src/**/*.vue"
    ]
}